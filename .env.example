# ═══════════════════════════════════════════════════════════
# MANA — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ═══════════════════════════════════════════════════════════

# ── Database ────────────────────────────────────────────────
DB_USERNAME=mana_user
DB_PASSWORD=your_strong_password_here
DB_ROOT_PASSWORD=your_root_password_here

# ── JWT Secret (REQUIRED) ───────────────────────────────────
# Generate with: openssl rand -base64 32
JWT_SECRET=your_base64_encoded_256_bit_secret_here

# ── Claude AI (optional - enables AI meal matching) ─────────
# Get from: https://console.anthropic.com
CLAUDE_API_KEY=sk-ant-api03-your-key-here

# ── Razorpay (optional - enables UPI/card payments) ─────────
# Get from: https://razorpay.com/docs/payments/dashboard/account-settings/api-keys/
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ── Frontend URLs ───────────────────────────────────────────
REACT_APP_API_URL=http://localhost:8080/api/v1
REACT_APP_RAZORPAY_KEY_ID=rzp_test_your_key_id

# ── File uploads ────────────────────────────────────────────
UPLOAD_DIR=uploads/

# ── Production overrides ────────────────────────────────────
# REACT_APP_API_URL=https://api.mana-food.in/api/v1
# SPRING_DATASOURCE_URL=jdbc:mysql://your-rds-endpoint:3306/mana_db
